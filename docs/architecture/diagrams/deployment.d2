direction: right
title: PitchVolt AI deployment architecture {
  shape: text
  near: top-center
  style.font-size: 24
}

local: Current implementation {
  source: Synthetic scenarios
  processor: Canonical MatchProcessor
  api: FastAPI + SSE
  ui: React / TypeScript broadcast
  checks: Pytest + Ruff + TS + Vitest + Biome
  image: Production OCI image {
    backend: Uvicorn + FastAPI
    static: Compiled React assets
  }

  source -> processor: canonical MatchEvent
  processor -> api: events + deterministic insights
  api -> ui: SSE + evidence HTTP
  checks -> processor: domain validation
  checks -> api: API contracts
  checks -> ui: generated OpenAPI types + UI checks
  api -> image.backend: packaged
  ui -> image.static: Vite production build
  image.static -> image.backend: same-origin static mount
}

azure: Azure target (planned, not deployed) {
  aca: Container Apps Consumption {
    runtime: One PitchVolt OCI workload
  }
  foundry: Microsoft Foundry {
    agents: Analyst + Storyteller + conditional Editor
  }
  telemetry: Structured telemetry

  aca.runtime -> foundry.agents: selective evidence-grounded requests
  foundry.agents -> aca.runtime: verified narrative candidate
  aca.runtime -> telemetry: metrics + traces
}

local.image -> azure.aca.runtime: deploy only after cost approval {
  style.stroke-dash: 5
}

legend: "Solid local flows = implemented. Dashed Azure deployment = approved target only."
