{
  "components": {
    "schemas": {
      "EventType": {
        "enum": [
          "pass",
          "pressure",
          "turnover",
          "carry",
          "shot",
          "goal"
        ],
        "title": "EventType",
        "type": "string"
      },
      "EvidenceResponse": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/MatchEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "insight_id": {
            "title": "Insight Id",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "title": "Metrics",
            "type": "object"
          }
        },
        "required": [
          "insight_id",
          "events",
          "metrics"
        ],
        "title": "EvidenceResponse",
        "type": "object"
      },
      "FictionalPlayer": {
        "additionalProperties": false,
        "properties": {
          "jersey_number": {
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Jersey Number",
            "type": "integer"
          },
          "player_id": {
            "minLength": 1,
            "title": "Player Id",
            "type": "string"
          },
          "surname": {
            "minLength": 1,
            "title": "Surname",
            "type": "string"
          }
        },
        "required": [
          "player_id",
          "surname",
          "jersey_number"
        ],
        "title": "FictionalPlayer",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LineupSample": {
        "additionalProperties": false,
        "properties": {
          "away_active": {
            "items": {
              "type": "string"
            },
            "title": "Away Active",
            "type": "array"
          },
          "clock_ms": {
            "minimum": 0.0,
            "title": "Clock Ms",
            "type": "integer"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "home_active": {
            "items": {
              "type": "string"
            },
            "title": "Home Active",
            "type": "array"
          }
        },
        "required": [
          "event_id",
          "clock_ms",
          "home_active",
          "away_active"
        ],
        "title": "LineupSample",
        "type": "object"
      },
      "MatchEvent": {
        "description": "Pitch coordinates follow a provider-neutral 105m x 68m convention.",
        "properties": {
          "clock_ms": {
            "minimum": 0.0,
            "title": "Clock Ms",
            "type": "integer"
          },
          "destination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "evidence": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Evidence",
            "type": "object"
          },
          "location": {
            "$ref": "#/components/schemas/Point"
          },
          "match_id": {
            "title": "Match Id",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "period": {
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Period",
            "type": "integer"
          },
          "player_id": {
            "title": "Player Id",
            "type": "string"
          },
          "possession_team_id": {
            "title": "Possession Team Id",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "schema_version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Schema Version",
            "type": "integer"
          },
          "sequence": {
            "minimum": 1.0,
            "title": "Sequence",
            "type": "integer"
          },
          "team_id": {
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "match_id",
          "event_id",
          "sequence",
          "period",
          "clock_ms",
          "observed_at",
          "team_id",
          "player_id",
          "event_type",
          "outcome",
          "location",
          "possession_team_id",
          "provenance"
        ],
        "title": "MatchEvent",
        "type": "object"
      },
      "MatchMetadata": {
        "properties": {
          "away_team_id": {
            "title": "Away Team Id",
            "type": "string"
          },
          "home_team_id": {
            "title": "Home Team Id",
            "type": "string"
          },
          "match_id": {
            "title": "Match Id",
            "type": "string"
          },
          "pitch_length_m": {
            "default": 105,
            "title": "Pitch Length M",
            "type": "number"
          },
          "pitch_width_m": {
            "default": 68,
            "title": "Pitch Width M",
            "type": "number"
          }
        },
        "required": [
          "match_id",
          "home_team_id",
          "away_team_id"
        ],
        "title": "MatchMetadata",
        "type": "object"
      },
      "MatchPresentation": {
        "additionalProperties": false,
        "properties": {
          "away": {
            "$ref": "#/components/schemas/TeamPresentation"
          },
          "coverage": {
            "enum": [
              "full_match",
              "excerpt"
            ],
            "title": "Coverage",
            "type": "string"
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/ScoreSample"
            },
            "title": "Goals",
            "type": "array"
          },
          "home": {
            "$ref": "#/components/schemas/TeamPresentation"
          },
          "initial_score_known": {
            "title": "Initial Score Known",
            "type": "boolean"
          },
          "lineup_samples": {
            "items": {
              "$ref": "#/components/schemas/LineupSample"
            },
            "title": "Lineup Samples",
            "type": "array"
          },
          "match_id": {
            "title": "Match Id",
            "type": "string"
          },
          "source": {
            "const": "authored_fictional",
            "default": "authored_fictional",
            "title": "Source",
            "type": "string"
          },
          "substitutions": {
            "items": {
              "$ref": "#/components/schemas/SubstitutionFact"
            },
            "title": "Substitutions",
            "type": "array"
          }
        },
        "required": [
          "match_id",
          "coverage",
          "home",
          "away",
          "initial_score_known",
          "goals",
          "substitutions",
          "lineup_samples"
        ],
        "title": "MatchPresentation",
        "type": "object"
      },
      "MatchStateResponse": {
        "properties": {
          "events_processed": {
            "title": "Events Processed",
            "type": "integer"
          },
          "insights": {
            "items": {
              "$ref": "#/components/schemas/TacticalInsightPayload"
            },
            "title": "Insights",
            "type": "array"
          },
          "match": {
            "$ref": "#/components/schemas/MatchMetadata"
          },
          "possession_team_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Possession Team Id"
          }
        },
        "required": [
          "match",
          "events_processed",
          "possession_team_id",
          "insights"
        ],
        "title": "MatchStateResponse",
        "type": "object"
      },
      "Outcome": {
        "enum": [
          "success",
          "failure",
          "neutral"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "Point": {
        "properties": {
          "x": {
            "maximum": 105.0,
            "minimum": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 68.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "title": "Point",
        "type": "object"
      },
      "Provenance": {
        "properties": {
          "generator": {
            "title": "Generator",
            "type": "string"
          },
          "generator_version": {
            "title": "Generator Version",
            "type": "string"
          },
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "source": {
            "default": "synthetic",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "generator",
          "generator_version",
          "seed",
          "scenario"
        ],
        "title": "Provenance",
        "type": "object"
      },
      "ReplayMessage": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "match_event",
              "tactical_insight"
            ],
            "title": "Kind",
            "type": "string"
          },
          "match_id": {
            "title": "Match Id",
            "type": "string"
          },
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatchEvent"
              },
              {
                "$ref": "#/components/schemas/TacticalInsightPayload"
              }
            ],
            "title": "Payload"
          }
        },
        "required": [
          "id",
          "kind",
          "match_id",
          "payload"
        ],
        "title": "ReplayMessage",
        "type": "object"
      },
      "ScenarioCatalog": {
        "properties": {
          "scenarios": {
            "items": {
              "type": "string"
            },
            "title": "Scenarios",
            "type": "array"
          }
        },
        "required": [
          "scenarios"
        ],
        "title": "ScenarioCatalog",
        "type": "object"
      },
      "ScoreSample": {
        "additionalProperties": false,
        "properties": {
          "away": {
            "minimum": 0.0,
            "title": "Away",
            "type": "integer"
          },
          "clock_ms": {
            "minimum": 0.0,
            "title": "Clock Ms",
            "type": "integer"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "home": {
            "minimum": 0.0,
            "title": "Home",
            "type": "integer"
          },
          "period": {
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Period",
            "type": "integer"
          }
        },
        "required": [
          "event_id",
          "period",
          "clock_ms",
          "home",
          "away"
        ],
        "title": "ScoreSample",
        "type": "object"
      },
      "SubstitutionFact": {
        "additionalProperties": false,
        "properties": {
          "clock_ms": {
            "minimum": 0.0,
            "title": "Clock Ms",
            "type": "integer"
          },
          "event_id": {
            "minLength": 1,
            "title": "Event Id",
            "type": "string"
          },
          "incoming_player_id": {
            "title": "Incoming Player Id",
            "type": "string"
          },
          "outgoing_player_id": {
            "title": "Outgoing Player Id",
            "type": "string"
          },
          "period": {
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Period",
            "type": "integer"
          },
          "team_id": {
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "team_id",
          "period",
          "clock_ms",
          "outgoing_player_id",
          "incoming_player_id"
        ],
        "title": "SubstitutionFact",
        "type": "object"
      },
      "TacticalInsightPayload": {
        "properties": {
          "clock_ms": {
            "title": "Clock Ms",
            "type": "integer"
          },
          "evidence_event_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Event Ids",
            "type": "array"
          },
          "insight_id": {
            "title": "Insight Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "title": "Metrics",
            "type": "object"
          },
          "team_id": {
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "insight_id",
          "kind",
          "team_id",
          "clock_ms",
          "evidence_event_ids",
          "metrics"
        ],
        "title": "TacticalInsightPayload",
        "type": "object"
      },
      "TeamPresentation": {
        "additionalProperties": false,
        "properties": {
          "abbreviation": {
            "title": "Abbreviation",
            "type": "string"
          },
          "coach": {
            "title": "Coach",
            "type": "string"
          },
          "emblem_text": {
            "maxLength": 3,
            "minLength": 1,
            "title": "Emblem Text",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/FictionalPlayer"
            },
            "title": "Players",
            "type": "array"
          },
          "primary_color": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Primary Color",
            "type": "string"
          },
          "secondary_color": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Secondary Color",
            "type": "string"
          },
          "starters": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starters"
          },
          "team_id": {
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "team_id",
          "name",
          "abbreviation",
          "primary_color",
          "secondary_color",
          "emblem_text",
          "coach",
          "players"
        ],
        "title": "TeamPresentation",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PitchVolt AI",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/matches/{name}/evidence/{insight_id}": {
      "get": {
        "operationId": "evidence_api_matches__name__evidence__insight_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "insight_id",
            "required": true,
            "schema": {
              "title": "Insight Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evidence"
      }
    },
    "/api/matches/{name}/presentation": {
      "get": {
        "description": "Read-only authored synthetic fixture facts + source-event score ledger.",
        "operationId": "match_presentation_api_matches__name__presentation_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchPresentation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match Presentation"
      }
    },
    "/api/matches/{name}/state": {
      "get": {
        "operationId": "match_state_api_matches__name__state_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchStateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match State"
      }
    },
    "/api/matches/{name}/stream": {
      "get": {
        "operationId": "stream_api_matches__name__stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "speed",
            "required": false,
            "schema": {
              "default": 1.0,
              "maximum": 1000,
              "minimum": 0.1,
              "title": "Speed",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream"
      }
    },
    "/api/matches/{name}/timeline": {
      "get": {
        "description": "Finite deterministic snapshot used for contract generation and replay inspection.",
        "operationId": "replay_timeline_api_matches__name__timeline_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReplayMessage"
                  },
                  "title": "Response Replay Timeline Api Matches  Name  Timeline Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replay Timeline"
      }
    },
    "/api/scenarios": {
      "get": {
        "operationId": "list_scenarios_api_scenarios_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioCatalog"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Scenarios"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
